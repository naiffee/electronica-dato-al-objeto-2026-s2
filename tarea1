int patitaLed = 9;
void setup() {
  //la patita 9 se va a comportar como SALIDA
  pinMode(patitaLed, OUTPUT);
}
void loop() {
  //2 argumentos: la patita, y si es HIGH o LOW
  // el .
  //punto();
  // la _
  //raya();

  //escribamos uno le dice a cero que la nada existe
  //uno
  punto (); punto(); //u
  raya();punto ();//n
  raya(); raya();raya(); //o
  delay(100); //para cerrar la letra

  //le 
  punto(); raya(); punto(); punto();//l
  punto();//e

  //dice
  raya(); punto(); punto();//d
  punto(); punto();//i
  raya(); punto (); raya(); punto ();//c
  punto();// e

  //a
  punto(); raya();//a

  //cero
  raya();punto();raya();punto();//c
  punto();//e
  punto();raya();punto();//r
  raya();raya();raya();//o

  //que
  raya(); raya(); punto (); raya();//q
  punto(); punto(); raya ();//u
  punto ();//e

  //la
  punto(); raya(); punto(); punto ();//l
  punto(); raya();//a

  //nada
  raya(); punto();//n
  punto(); raya();//a 
  raya(); punto(); punto();//d
  punto(); raya();//a 

  //existe
  punto ();//e
  raya(); punto(); punto(); raya();//x
  punto(); punto();//i
  punto(); punto(); punto(); //s
  raya(); //t
  punto ();//e
  
  
    
}

void punto(){
  // esta función va a escribir un punto en mi led
  // el .
  digitalWrite(patitaLed, HIGH);
  delay(100); //delay se coloca en milisegundos
  digitalWrite(patitaLed, LOW);
  delay(500);
}


void raya(){
  digitalWrite(patitaLed, HIGH);
  delay(1000); //delay se coloca en milisegundos
  digitalWrite(patitaLed, LOW);
  delay(500);
}
